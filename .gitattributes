# Auto detect text files and perform LF normalization
* text=auto

# Custom for Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Force shell scripts to LF
*.sh text eol=lf

# Force batch scripts to CRLF
*.bat text eol=crlf

# Define binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.jpg binary
*.png binary
*.gif binary
*.ico binary
*.zip binary
*.pem binary

# Force specific text files to LF
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf